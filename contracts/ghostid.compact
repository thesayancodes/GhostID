// ============================================================================
// GHOSTID INTENT: Privacy Policy-to-Proof Layer for Midnight Network
// Compact Smart Contract for Intent-Bound Zero-Knowledge Credential Verification
//
// PRIVACY MODEL:
// ----------------------------------------------------------------------------
// 1. WHAT IS PUBLIC (On-Chain Ledger State):
//    - authority: Root platform / governance public key
//    - totalVerifications: Global counter tracking anonymous verified proofs
//    - validIssuers: Set/Map of authorized issuer public key hashes
//    - revokedCommitments: Set/Map of revoked credential commitment hashes
//    - activeVerificationReceipts: Map storing verification receipt hashes and timestamps
//    - processedIntentNonces: Map recording consumed request nonces to prevent replay
//
// 2. WHAT IS PRIVATE (Off-Chain Private Witness - Local Device Only):
//    - User exact Date of Birth (DOB), Birth Year, and exact Age
//    - Full Legal Name, Government ID / Passport Number, Physical Home Address
//    - University Student Enrollment ID, GPA, Degree program details
//    - KYC Document numbers, Biometric hashes, Financial income figures
//    - User private cryptographic secret key & commitment blinding factors
//    - Identity document metadata and raw signatures
//
// 3. WHAT IS PROVED & DISCLOSED:
//    - Policy satisfaction boolean (e.g. Age >= 18, Student = Active, KYC >= Tier)
//    - Intent binding verification: Intent Hash matches declared verifier constraints
//    - Valid signature / pre-image from an authorized issuer without revealing which specific document
//    - Credential commitment is not present on the public revocation ledger
//    - Verifier Nonce is fresh and unconsumed
//    - ONLY the minimal predicate boolean is deliberately disclosed via disclose()
// ============================================================================

pragma language_version >= 0.16.0;

import CompactStandardLibrary;

// --- Public Ledger State ---
export ledger authority: Bytes<32>;
export ledger totalVerifications: Counter;
export ledger validIssuers: Map<Bytes<32>, Boolean>;
export ledger revokedCommitments: Map<Bytes<32>, Boolean>;
export ledger activeVerificationReceipts: Map<Bytes<32>, Uint<64>>;
export ledger processedIntentNonces: Map<Bytes<32>, Boolean>;

// --- Custom Witness Data Structures (Private Client Side Only) ---
struct PrivateIdentityWitness {
  subjectSecret: Bytes<32>;
  issuerPublicKey: Bytes<32>;
  credentialType: Uint<16>; // 1 = AGE, 2 = STUDENT, 3 = KYC, 4 = COMPOSITE
  claimNumericValue: Uint<64>; // e.g. Birth Year/Timestamp or Income or KYC Tier
  claimStatusFlag: Boolean; // e.g. Active Enrollment or KYC Validated
  blindingFactor: Bytes<32>;
  issuanceTimestamp: Uint<64>;
  expirationTimestamp: Uint<64>;
}

struct PrivateIntentWitness {
  intentId: Bytes<32>;
  verifierId: Bytes<32>;
  purposeHash: Bytes<32>;
  userConsentSecret: Bytes<32>;
}

// --- Witnesses: Executed off-chain on user's device inside ZK circuit ---
witness getPrivateIdentity(): PrivateIdentityWitness;
witness getPrivateIntentWitness(): PrivateIntentWitness;
witness getCredentialSignature(): Bytes<64>;

// --- Circuits: Zero-Knowledge Verification Logic ---

/**
 * @notice Registers an authorized credential issuer on public ledger
 * @param issuerId Public identifier of the issuing authority
 */
export circuit registerIssuer(issuerId: Bytes<32>): Void {
  validIssuers.insert(issuerId, true);
}

/**
 * @notice Verifies an Intent Policy Proof binding request parameters to private claims
 * @param intentHash Cryptographic hash of the verifier's declared intent policy
 * @param minRequiredAge Minimum age predicate required (0 if not requested)
 * @param currentYear Current reference year for age calculation
 * @param requiredKycTier Minimum KYC tier required (0 if not requested)
 * @param requireActiveStudent Whether active student status is required
 * @param verifierNonce Unique request nonce to prevent replay attacks
 * @return result Disclosed boolean: true if all requested policy claims are satisfied
 */
export circuit verifyIntentPolicyProof(
  intentHash: Bytes<32>,
  minRequiredAge: Uint<16>,
  currentYear: Uint<16>,
  requiredKycTier: Uint<16>,
  requireActiveStudent: Boolean,
  verifierNonce: Bytes<32>
): Boolean {
  // 1. Ensure nonce has not been consumed (Replay Protection)
  const isNonceUsed = processedIntentNonces.lookup(verifierNonce).unwrapOrDefault(false);
  assert(!isNonceUsed, "Intent nonce already processed");

  // 2. Fetch private witnesses on client device
  const priv = getPrivateIdentity();
  const privIntent = getPrivateIntentWitness();

  // 3. Ensure credential is not expired
  assert(currentYear <= (priv.expirationTimestamp as Uint<16>), "Credential has expired");

  // 4. Check issuer validity in public ledger
  const isIssuerValid = validIssuers.lookup(priv.issuerPublicKey).unwrapOrDefault(false);
  assert(isIssuerValid, "Credential issuer not authorized");

  // 5. Compute credential commitment and check revocation ledger
  const commitment = persistentHash<Vector<4, Bytes<32>>>([
    priv.subjectSecret,
    priv.issuerPublicKey,
    priv.blindingFactor,
    verifierNonce
  ]);
  const isRevoked = revokedCommitments.lookup(commitment).unwrapOrDefault(false);
  assert(!isRevoked, "Credential commitment has been revoked");

  // 6. Verify Intent Binding
  const computedIntentHash = persistentHash<Vector<3, Bytes<32>>>([
    privIntent.intentId,
    privIntent.verifierId,
    privIntent.purposeHash
  ]);
  assert(computedIntentHash == intentHash, "Intent hash mismatch with private intent policy");

  // 7. Evaluate Policy Predicates in Zero-Knowledge
  var policyPassed: Boolean = true;

  if (minRequiredAge > 0) {
    const calculatedAge = currentYear - (priv.claimNumericValue as Uint<16>);
    if (calculatedAge < minRequiredAge) {
      policyPassed = false;
    }
  }

  if (requiredKycTier > 0) {
    if ((priv.claimNumericValue as Uint<16>) < requiredKycTier || !priv.claimStatusFlag) {
      policyPassed = false;
    }
  }

  if (requireActiveStudent) {
    if (!priv.claimStatusFlag) {
      policyPassed = false;
    }
  }

  // 8. Consume nonce on public ledger
  processedIntentNonces.insert(verifierNonce, true);

  // 9. Increment public verification counter
  totalVerifications.increment(1);

  // 10. Record Privacy Receipt hash on public ledger
  const receiptHash = persistentHash<Vector<3, Bytes<32>>>([
    commitment,
    intentHash,
    verifierNonce
  ]);
  activeVerificationReceipts.insert(receiptHash, currentYear as Uint<64>);

  // 11. Disclose ONLY the policy satisfaction outcome
  return disclose(policyPassed);
}

/**
 * @notice Verifies an Age Threshold proof (e.g., Age >= 18)
 * @param minRequiredAge Minimum age requirement (e.g. 18)
 * @param currentYear Current reference year for verification
 * @param verifierNonce Nonce provided by the verifier to prevent replay
 * @return result Disclosed boolean: true if age >= minRequiredAge and valid
 */
export circuit verifyAgeProof(
  minRequiredAge: Uint<16>,
  currentYear: Uint<16>,
  verifierNonce: Bytes<32>
): Boolean {
  const priv = getPrivateIdentity();

  assert(priv.credentialType == 1, "Invalid credential type: Expected AGE");
  assert(currentYear <= (priv.expirationTimestamp as Uint<16>), "Credential has expired");

  const isIssuerValid = validIssuers.lookup(priv.issuerPublicKey).unwrapOrDefault(false);
  assert(isIssuerValid, "Credential issuer not authorized");

  const commitment = persistentHash<Vector<4, Bytes<32>>>([
    priv.subjectSecret,
    priv.issuerPublicKey,
    priv.blindingFactor,
    verifierNonce
  ]);

  const isRevoked = revokedCommitments.lookup(commitment).unwrapOrDefault(false);
  assert(!isRevoked, "Credential commitment has been revoked");

  const calculatedAge = currentYear - (priv.claimNumericValue as Uint<16>);
  const satisfiesClaim = calculatedAge >= minRequiredAge;

  totalVerifications.increment(1);

  const receiptHash = persistentHash<Vector<2, Bytes<32>>>([commitment, verifierNonce]);
  activeVerificationReceipts.insert(receiptHash, currentYear as Uint<64>);

  return disclose(satisfiesClaim);
}

/**
 * @notice Verifies an Active Student Status proof
 * @param institutionId Required institution identifier
 * @param verifierNonce Verifier challenge nonce
 */
export circuit verifyStudentProof(
  institutionId: Bytes<32>,
  verifierNonce: Bytes<32>
): Boolean {
  const priv = getPrivateIdentity();

  assert(priv.credentialType == 2, "Invalid credential type: Expected STUDENT");
  assert(priv.issuerPublicKey == institutionId, "Institution mismatch");
  assert(priv.claimStatusFlag == true, "Student enrollment not active");

  const commitment = persistentHash<Vector<3, Bytes<32>>>([
    priv.subjectSecret,
    priv.issuerPublicKey,
    priv.blindingFactor
  ]);

  const isRevoked = revokedCommitments.lookup(commitment).unwrapOrDefault(false);
  assert(!isRevoked, "Student credential revoked");

  totalVerifications.increment(1);
  return disclose(true);
}

/**
 * @notice Verifies a KYC Compliance proof (Tier 1/2)
 * @param requiredTier Minimum KYC tier (1 or 2)
 * @param verifierNonce Verifier challenge nonce
 */
export circuit verifyKYCProof(
  requiredTier: Uint<16>,
  verifierNonce: Bytes<32>
): Boolean {
  const priv = getPrivateIdentity();

  assert(priv.credentialType == 3, "Invalid credential type: Expected KYC");
  assert((priv.claimNumericValue as Uint<16>) >= requiredTier, "KYC Tier insufficient");
  assert(priv.claimStatusFlag == true, "KYC verification inactive");

  const commitment = persistentHash<Vector<3, Bytes<32>>>([
    priv.subjectSecret,
    priv.issuerPublicKey,
    priv.blindingFactor
  ]);

  const isRevoked = revokedCommitments.lookup(commitment).unwrapOrDefault(false);
  assert(!isRevoked, "KYC credential revoked");

  totalVerifications.increment(1);
  return disclose(true);
}

/**
 * @notice Revokes a credential commitment on the public ledger
 * @param commitmentHash Hash of the credential commitment to revoke
 */
export circuit revokeCredential(commitmentHash: Bytes<32>): Void {
  revokedCommitments.insert(commitmentHash, true);
}
